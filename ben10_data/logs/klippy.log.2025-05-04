check_gain_time = 90
hysteresis = 5
heating_gain = 2

[z_thermal_adjust]
temp_coeff = 0.0
smooth_time = 2.0
z_adjust_off_above = 99999999.0
max_z_adjustment = 99999999.0
sensor_type = EPCOS 100K B57560G104F
sensor_pin = PK5
