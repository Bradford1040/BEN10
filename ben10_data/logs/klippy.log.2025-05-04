heater_pin = PH5
sensor_type = EPCOS 100K B57560G104F
sensor_pin = PK6
control = pid
pid_kp = 201.86
pid_ki = 10.67
pid_kd = 954.96
min_temp = 0
max_temp = 120

[verify_heater heater_bed]
