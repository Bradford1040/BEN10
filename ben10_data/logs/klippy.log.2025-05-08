dir_pin = !PL1
enable_pin = !PK0
microsteps = 16
rotation_distance = 8
position_min = -2
position_max = 395
homing_speed = 8
homing_retract_dist = 10.0
homing_retract_speed = 8
second_homing_speed = 4
use_sensorless_homing = False
endstop_pin = ^PD3
high_precision_step_compress = False
position_endstop = 0.400

[firmware_retraction]
