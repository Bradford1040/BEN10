sensor_type = EPCOS 100K B57560G104F
sensor_pin = PK6
control = pid
pid_kp = 201.86
pid_ki = 10.67
pid_kd = 954.96
min_temp = 0
max_temp = 120

[verify_heater heater_bed]
max_error = 120
check_gain_time = 90
hysteresis = 5
heating_gain = 2

[z_thermal_adjust]
temp_coeff = 0.0
smooth_time = 2.0
z_adjust_off_above = 99999999.0
max_z_adjustment = 99999999.0
sensor_type = EPCOS 100K B57560G104F
sensor_pin = PK5
min_temp = 0
max_temp = 300

[bed_screws]
screw1 = 30,40
screw1_name = front left screw
screw2 = 270,40
screw2_name = front right screw
screw3 = 270,270
screw3_name = rear right screw
screw4 = 30,270
screw4_name = rear left screw
speed = 50
horizontal_move_z = 7

[gcode_macro BED_TRAMMING]
gcode = 
	M190 S72
	M109 S220
	_B28
	G4 P2000
	BED_SCREWS_ADJUST

[gcode_macro PID_BED]
