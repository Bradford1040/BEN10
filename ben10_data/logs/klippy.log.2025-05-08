dir_pin = PF7
enable_pin = !PF2
microsteps = 16
rotation_distance = 40
endstop_pin = ^PJ1
position_endstop = 0
position_min = 0
position_max = 305
homing_speed = 50
homing_retract_dist = 10.0
homing_retract_speed = 8
second_homing_speed = 8
use_sensorless_homing = False
high_precision_step_compress = False

[stepper_z]
